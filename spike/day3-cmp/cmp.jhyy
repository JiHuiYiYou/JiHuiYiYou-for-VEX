// cmp.jhyy —— **Day 3 行为对照**的 JHYY 源
//
// ★ A 路（JHYY → C → clang）与 B 路（JHYY → ARM 汇编 → clang）
//   **烧的是同一份源码** ⇒ 两路行为必须一致 ⇒ 这是 ABI 的行为级检查。
//   C++ 参考（`vex-cpp/src/main.cpp`）是**同一段逻辑的另一种写法**（vex:: 类）。
//
// ⚠️ **这是「最后一趟上机」的产物** ⇒ 一次烧录要把能测的都测掉：
//    四行结论 = 一份**体检报告**（三条路必须逐字相同）：
//
//      (1,  1)  MOTOR MOVED / MOTOR NO MOVE   ← 电机到底转没转（实测速度）
//      (1, 20)  CONFIG OK / CONFIG BAD       ← 刹车/编码器单位/齿轮组**读回**对不对
//      (1, 40)  REVF FLIP / REVF SAME / REVF NA ← **反转标志**到底改不改方向
//      (1, 60)  JHY CMP DONE                  ← 跑到底了（不是卡住）
//
//    `REVF` 那条顺带**补上规格书最后一个缺口**（事实基线 § 13.1「还缺的」）：
//    上一轮探针测不出结论，是因为**探针自己有 bug** —— 置完标志又走了一遍
//    `config_motor()`，可能把标志清了 ⇒ 读回全同，分不清是「标志被清」还是
//    「标志本来就不影响读回」。这里改成 **先 config → 再置标志 → 再 spin**，
//    并且 **spin 之后再读一次标志** ⇒ 两种情况能分开（标志没置上 ⇒ REVF NA）。
//
// ⚠️ 屏显走**非变参封装** `jhyy_vex_display_puts`（不是变参的 vexDisplayPrintf）⇒
//    三条路调的是**同一个符号**、**同一份语义**（事实基线 § 9.4）。

extern fn vexDeviceGetByIndex(index: u32) -> *u8;
extern fn vexDeviceMotorGearingSet(dev: *u8, gear: i32);
extern fn vexDeviceMotorBrakeModeSet(dev: *u8, mode: i32);
extern fn vexDeviceMotorEncoderUnitsSet(dev: *u8, units: i32);
extern fn vexDeviceMotorVelocitySet(dev: *u8, velocity: i32);
extern fn vexDeviceMotorBrakeModeGet(dev: *u8) -> i32;
extern fn vexDeviceMotorEncoderUnitsGet(dev: *u8) -> i32;
extern fn vexDeviceMotorGearingGet(dev: *u8) -> i32;
extern fn vexDeviceMotorReverseFlagSet(dev: *u8, flag: bool);
extern fn vexDeviceMotorReverseFlagGet(dev: *u8) -> bool;
extern fn vexDeviceAbsEncVelocityGet(dev: *u8) -> i32;
extern fn vexDelay(ms: u32);
extern fn jhyy_vex_display_puts(xpos: i32, ypos: i32, text: *u8);

fn main_jhyy() -> i32 {
    // ① 句柄（索引 0 = PORT1）
    let dev = vexDeviceGetByIndex(0);

    // ② 配置 —— 传的是 **enum 序号**（0/1/2），语义见绑定面表
    //    ⚠️ **必须在置反转标志之前**（顺序反了标志可能被清）
    vexDeviceMotorGearingSet(dev, 1);       // 1 = 18:1
    vexDeviceMotorBrakeModeSet(dev, 1);     // 1 = Brake
    vexDeviceMotorEncoderUnitsSet(dev, 0);  // 0 = Degrees

    // ③ 读回三个配置（★ enum 返回 ⇒ B 路必须掩码 0xff）
    let brake = vexDeviceMotorBrakeModeGet(dev);
    let enc = vexDeviceMotorEncoderUnitsGet(dev);
    let gear = vexDeviceMotorGearingGet(dev);

    // ④ 转 500 ms，读**实测**速度（绝对编码器，RPM）
    vexDeviceMotorVelocitySet(dev, 50);
    vexDelay(500 as u32);
    let v = vexDeviceAbsEncVelocityGet(dev);
    vexDeviceMotorVelocitySet(dev, 0);

    // ⑤ 反转标志实验：置上 → **再读一次** → 再转一次 → 看方向反没反
    vexDeviceMotorReverseFlagSet(dev, true);
    let flag = vexDeviceMotorReverseFlagGet(dev);
    vexDeviceMotorVelocitySet(dev, 50);
    vexDelay(500 as u32);
    let v2 = vexDeviceAbsEncVelocityGet(dev);
    vexDeviceMotorVelocitySet(dev, 0);
    vexDeviceMotorReverseFlagSet(dev, false);   // 复位，别把机器人留在反的

    // ⑥ 四行结论（三条路必须**逐字相同**）
    if v > 20 || v < -20 {
        jhyy_vex_display_puts(1, 1, "MOTOR MOVED" as *u8);
    } else {
        jhyy_vex_display_puts(1, 1, "MOTOR NO MOVE" as *u8);
    }
    if brake == 1 && enc == 0 && gear == 1 {
        jhyy_vex_display_puts(1, 20, "CONFIG OK" as *u8);
    } else {
        jhyy_vex_display_puts(1, 20, "CONFIG BAD" as *u8);
    }
    if flag {
        if v2 < 0 {
            jhyy_vex_display_puts(1, 40, "REVF FLIP" as *u8);
        } else {
            jhyy_vex_display_puts(1, 40, "REVF SAME" as *u8);
        }
    } else {
        jhyy_vex_display_puts(1, 40, "REVF NA" as *u8);
    }
    jhyy_vex_display_puts(1, 60, "JHY CMP DONE" as *u8);

    // main 是被 vexTaskAdd 注册进固件调度器的**一个 task** ⇒ 必须让出时间片
    while 1 != 0 {
        vexDelay(100 as u32);
    }
    return 0;
}
